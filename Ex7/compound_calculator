#Python compound interest calculator

principle = 0
rate = 0
time = 0

while principle <= 0:
    principle = float(input("Enter the principle amount: "))
    if principle <= 0:
        print("Your amount must be greater than 0")

while rate <= 0:
    rate = float(input("Enter the interest rate: "))
    if rate <= 0:
        print("Your rate must be greater than 0")

while time <= 0:
    time = int(input("Enter the time in years: "))
    if time <= 0:
        print("Your time must be a positive integer")

a = principle * pow(1 + rate/100, time)

print(f"Your initial principle is {principle}, the interest rate it's {rate} and the time it's {time}")
print(f"The final amount is {a:.2f}")
